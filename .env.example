# APK Studio — build xidməti (yalnız server tərəfində; brauzerə çıxmır).
# Vercel-də: Project Settings → Environment Variables. Bu faylı .env kimi commit etməyin.

# Build repozitoriyasına (PRIVATE) giriş tokeni — fine-grained PAT.
# İcazələr: Contents: Read and write, Actions: Read and write, Metadata: Read-only
GITHUB_TOKEN=

# Build repozitoriyası: sahib/repo (məs. mmuxax-bot/apk-builds). Mütləq private olmalıdır!
GITHUB_REPO=

# --- İstəyə bağlı ---
# Workflow-un olduğu branch (default: main)
# GITHUB_BRANCH=main
# Yerli test üçün saxta GitHub API (scripts/mock-github.mjs)
# GITHUB_API_BASE=http://127.0.0.1:4010
# Sürət limitləri (hər IP üçün, best-effort)
# APK_MAX_BUILDS_PER_HOUR=8
# APK_MAX_CHUNKS_PER_10MIN=120
# APK_MAX_STATUS_PER_MIN=60
# APK_MAX_DOWNLOADS_PER_10MIN=30
